# ==========================================
# 1. LOKALER ZUGRIFF (nur im Heimnetz / VPN)
# ==========================================

searx.lan {
	tls internal
	reverse_proxy searxng:8080
}

dozzle.lan {
	tls internal
	reverse_proxy dozzle:8080
}

kuma.lan {
	tls internal
	reverse_proxy uptime-kuma:3001
}

beszel.lan {
	tls internal
	reverse_proxy beszel:8090
}

pihole.lan {
	tls internal
	redir / /admin
	reverse_proxy pihole:80
}

portainer.lan {
	tls internal
	reverse_proxy portainer:9000
}

# ==========================================
# 2. ÖFFENTLICHER ZUGRIFF (Let's Encrypt SSL)
# ==========================================

dozzle.mg0050.duckdns.org {
	reverse_proxy dozzle:8080
}

kuma.mg0050.duckdns.org {
	reverse_proxy uptime-kuma:3001
}

beszel.mg0050.duckdns.org {
	reverse_proxy beszel:8090
}

portainer.mg0050.duckdns.org {
	reverse_proxy https://192.168.178.140:9443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}

