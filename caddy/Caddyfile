# ==========================================
# 1. LOKALER ZUGRIFF (nur im Heimnetz / VPN)
# ==========================================

:8080 {
    respond /health "OK" 200
}

searx.lan {
	tls internal
	reverse_proxy searxng:8080
}

dozzle.lan {
	tls internal
	reverse_proxy dozzle:8080
}

kuma.lan {
	tls internal
	reverse_proxy uptime-kuma:3001
}

beszel.lan {
	tls internal
	reverse_proxy beszel:8090
}

pihole.lan {
	tls internal
	redir / /admin
	reverse_proxy pihole:80
}

portainer.lan {
    tls internal
    reverse_proxy https://portainer:9443 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

# ==========================================
# 2. ÖFFENTLICHER ZUGRIFF (Let's Encrypt SSL)
# ==========================================

dozzle.mg0050.duckdns.org {
	reverse_proxy dozzle:8080
}

kuma.mg0050.duckdns.org {
	reverse_proxy uptime-kuma:3001
}

beszel.mg0050.duckdns.org {
	reverse_proxy beszel:8090
}

portainer.mg0050.duckdns.org {
	@blocked {
		not path /api/webhooks/* /api/stacks/webhooks/*
		not remote_ip 192.168.178.0/24 127.0.0.1
	}
	respond @blocked "Access Denied" 403

	reverse_proxy https://portainer:9443 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
