services:
  searxng:
    image: docker.io/searxng/searxng:{{ versions.searxng }}
    container_name: searxng
    restart: unless-stopped
    volumes:
      - ./config:/etc/searxng
      - ./data:/var/cache/searxng
    networks:
      - caddy_net
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:8080/healthz"]
      interval: 10s
      timeout: 3s
      retries: 2
      start_period: 15s

networks:
  caddy_net:
    external: true
