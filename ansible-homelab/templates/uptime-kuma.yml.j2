services:
  uptime-kuma:
    image: louislam/uptime-kuma:{{ versions.uptime_kuma }}
    container_name: uptime-kuma
    restart: unless-stopped
    volumes:
      - uptime-kuma-data:/app/data
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - caddy_net

volumes:
  uptime-kuma-data:

networks:
  caddy_net:
    external: true

